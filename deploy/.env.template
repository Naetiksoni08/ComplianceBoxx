# ============================================================================
#  ComplianceBoxx — SECRET CONFIGURATION
# ============================================================================
#
#  HOW TO USE
#  ----------
#  1. Copy this file and rename it to exactly:   .env
#  2. Fill in the 2 blanks marked  <<<< FILL HERE
#  3. Upload it ONE LEVEL ABOVE public_html (safest),
#     i.e. next to public_html, not inside it.
#
#  WHERE TO PUT IT
#  ---------------
#  Best   :  /home/u238326104/.env                (outside the web root)
#  OK     :  public_html/.env                     (a .htaccess rule blocks it,
#                                                 but outside is still safer)
#
#  NEVER upload this .env.template file itself to the server.
#  NEVER commit the filled .env to Git.
#
# ============================================================================


# ---------------------------------------------------------------------------
# DATABASE  (Hostinger hPanel -> Databases)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_NAME=u238326104_leads_db
DB_USER=u238326104_cb_admin
DB_PASS=<<<< FILL HERE — the MySQL password you set while creating the database

# How long a single IP can submit the form before being paused (in seconds).
# 3600 = 1 hour. Raise it if you ever get more than a handful of leads per hour.
RATE_LIMIT_PER_HOUR=5


# ---------------------------------------------------------------------------
# EMAIL  (Hostinger hPanel -> Emails)
# ---------------------------------------------------------------------------
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USER=contact@complianceboxx.in
MAIL_PASS=<<<< FILL HERE — the password of the contact@complianceboxx.in mailbox
MAIL_FROM=contact@complianceboxx.in
MAIL_FROM_NAME=ComplianceBoxx


# ---------------------------------------------------------------------------
# WHO GETS NOTIFIED
# ---------------------------------------------------------------------------
# Change true <-> false any time you like. No code editing required.

# The person who filled the form gets a "thank you" confirmation email.
SEND_MAIL_TO_USER=true

# You (the founder / sales team) get a lead alert with all the details.
SEND_MAIL_TO_FOUNDER=true

# Where the lead alert goes. Use your own mailbox if you prefer.
FOUNDER_EMAIL=contact@complianceboxx.in


# ---------------------------------------------------------------------------
# SITE DETAILS  (used in the email text and buttons)
# ---------------------------------------------------------------------------
SITE_NAME=ComplianceBoxx
SITE_PHONE=+91 99112 92157
SITE_PHONE_E164=+919911292157


# ---------------------------------------------------------------------------
# OPTIONAL — ad tracking (safe to leave off for now, add BEFORE running ads)
# ---------------------------------------------------------------------------
# Once you start running Google or Meta ads, set this to true. The form will
# start recording which ad each lead came from. This CANNOT be recovered later,
# so enable it before the ads go live, not after.
CAPTURE_UTM=false